# Docker Compose
COMPOSE_PROJECT_NAME=chembl-similarity-dwh
AIRFLOW_UID=1000

# Airflow metadata database, never exposed outside the compose network
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# Airflow web login and secrets. Generate the two keys, see README.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=
AIRFLOW_WEB_PORT=8080

# Data warehouse. Compose assembles the DSN and the Airflow connection from these.
CHEMBL_DWH_USER=chembl
CHEMBL_DWH_PASSWORD=chembl
CHEMBL_DWH_NAME=chembl_dwh
CHEMBL_DWH_HOST=postgres-dwh
CHEMBL_DWH_PORT=5432
CHEMBL_DWH_HOST_PORT=5433

CHEMBL_LOG_LEVEL=INFO

# ChEMBL REST API. Latency varies by 10x and the server returns 500s under
# concurrency, so retries and a modest worker count are deliberate.
CHEMBL_API_BASE_URL=https://www.ebi.ac.uk/chembl/api/data
CHEMBL_API_PAGE_SIZE=1000
CHEMBL_API_TIMEOUT_SECONDS=180
CHEMBL_API_MAX_RETRIES=5
CHEMBL_API_REQUESTS_PER_SECOND=6
CHEMBL_API_MAX_WORKERS=6

# ChEMBL release dump, uunaffected by API outages,
# so this is the default ingest path.
CHEMBL_DUMP_BASE_URL=https://ftp.ebi.ac.uk/pub/databases/chembl/ChEMBLdb/latest
CHEMBL_DUMP_DIR=/opt/airflow/data
CHEMBL_DUMP_CHUNK_SIZE=8388608
CHEMBL_DUMP_TIMEOUT_SECONDS=300

# AWS. botocore writes to the SSO token cache, so the mount cannot be read-only.
AWS_PROFILE=De-School-students
AWS_DEFAULT_REGION=eu-central-1

# S3 layout. Everything this project produces lives under the root prefix.
CHEMBL_S3_BUCKET=de-school-educational-data
CHEMBL_S3_ROOT_PREFIX=final_task/javakhishvili_luka

# Morgan fingerprints, radius and bit count fixed by the task specification
CHEMBL_FP_RADIUS=2
CHEMBL_FP_N_BITS=2048
CHEMBL_FP_SHARD_SIZE=250000

# Personal input files, and the source set size the task asks for
CHEMBL_INPUT_PREFIX=input/luka-javakhishvili
CHEMBL_SOURCE_TARGET_SIZE=100

# Similarity search. The block size bounds peak memory rather than tuning speed.
CHEMBL_SIMILARITY_TOP_N=10
CHEMBL_SIMILARITY_BLOCK_SIZE=250000

# Failure notifications. Leave the URL empty to disable alerting entirely.
CHEMBL_TEAMS_WEBHOOK_URL=
CHEMBL_TEAMS_TIMEOUT_SECONDS=15
