# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Airflow runtime. The logs directory itself is tracked so docker never has to
# create it, which would leave it owned by root.
logs/*
!logs/.gitkeep
plugins/
airflow.db
airflow-webserver.pid
standalone_admin_password.txt

# Secrets and machine-local config
.env
*.pem

# Local data artefacts, everything durable lives in S3 or Postgres
data/*
!data/.gitkeep
*.parquet

# Editors
.idea/
.vscode/
*.swp
